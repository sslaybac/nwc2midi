diff -ru nwc2xml/objects.js nwc2xml/objects.js
--- nwc2xml/objects.js	2026-11-19 15:59:30.500647132 -0800
+++ nwc2xml/objects.js	2026-11-19 16:00:08.422263897 -0800
@@ -68,9 +68,15 @@
   constructor(s) { super(ObjType.Instrument, s); this.name = ''; }
   load(r) {
     super.load(r);
+    // [nwc2midi] decode the patch: byte 6 of the fixed part, 1-based (0 = none).
+    // Verified against the instrument names stored in 2.0x files.
+    const at = r.tell();
     if (this.version < NWC_Version.V170) r.skip(6);
     else if (this.version < NWC_Version.V200) r.skip(8);
-    else { r.skip(8); this.name = r.readStringNul(); r.skip(9); }
+    else { r.skip(8); this.name = r.readStringNul(); r.skip(1); this.dynamicVelocity = Array.from(r.readBytes(8)); }
+    const rawPatch = this.version >= NWC_Version.V170 ? r.buffer[at + 6] : 0;
+    this.patchUnset = rawPatch === 0;
+    this.patch = Math.max(rawPatch - 1, 0);
   }
 }
 
@@ -291,7 +297,22 @@
   load(r) {
     super.load(r);
     this.pos = r.readInt8(); this.placement = r.readUint8();
-    r.skip(this.version <= NWC_Version.V155 ? 0x1E : 32);
+    if (this.version <= NWC_Version.V155) { r.skip(0x1E); this.points = []; return; }
+    // [nwc2midi] decode the 32-byte body (layout inferred from real files):
+    //   u16 controller (0 tempo, 1 volume, 4 pitch bend; others unverified)
+    //   u16 style (0 absolute, 1 linear sweep)
+    //   u16 time resolution (0 whole, 1 half, 2 quarter, 3 eighth, ...)
+    //   u16 sweep resolution (steps per time unit)
+    //   4 points x { u16 used, u16 time delta in resolution units, u16 value }
+    this.controller = r.readUint16();
+    this.style = r.readUint16();
+    this.timeRes = r.readUint16();
+    this.sweepRes = r.readUint16();
+    this.points = [];
+    for (let i = 0; i < 4; i++) {
+      const used = r.readUint16(), delta = r.readUint16(), value = r.readUint16();
+      if (used) this.points.push({ delta, value });
+    }
   }
 }
 
